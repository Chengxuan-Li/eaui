# Configuration template: variable names and safe placeholders only.
# Copy to the ignored .env.local and put real values there, never in Git.
# Server-side only: never rename these with a VITE_ prefix, because Vite exposes VITE_ variables to the browser bundle.
# The dev server reads these in Node and proxies /api/llm for the browser (decision 0020), so the key never reaches
# client code. A built bundle has no such route and falls back to the scripted agent.
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_MODEL=gpt-5.6-luna
# Optional: point the proxy at a compatible endpoint. Defaults to https://api.openai.com/v1
OPENAI_BASE_URL=
