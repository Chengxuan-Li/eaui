# Configuration template: variable names and safe placeholders only.
# Copy to the ignored .env.local and put real values there, never in Git.
# Server-side only: never rename these with a VITE_ prefix, because Vite exposes VITE_ variables to the browser bundle.
# Reserved for a future real model provider behind the agent adapter; the first slice (decision 0006) reads no variables.
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_MODEL=gpt-5.6-luna
